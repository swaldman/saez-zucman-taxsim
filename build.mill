//| mill-version: 1.3.1
package build

import mill.*
import mill.scalalib.*
import mill.scalajslib.*

object Versions:
  val scala   = "3.3.7"
  val scalaJS = "1.20.1"
  val upickle = "4.3.2"
  val munit   = "1.1.1"
  val laminar = "17.2.1"

/** Common settings for modules that cross-build to the JVM and Scala.js.
 *  Sources: `<module>/src` (shared), `<module>/src-jvm`, `<module>/src-js`. */
trait Shared extends ScalaModule with PlatformScalaModule:
  def scalaVersion = Versions.scala
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-Wunused:imports")

trait SharedJS extends Shared with ScalaJSModule:
  def scalaJSVersion = Versions.scalaJS

trait SharedTests extends TestModule.Munit:
  def mvnDeps = Seq(mvn"org.scalameta::munit::${Versions.munit}")

/** The pure simulation engine. No IO, no reflection: JS-safe. */
object core extends Module:
  object jvm extends Shared:
    object test extends ScalaTests with SharedTests
  object js extends SharedJS:
    object test extends ScalaJSTests with SharedTests

/** Datasets (embedded) and JSON/CSV codecs. */
object data extends Module:
  trait DataShared extends Shared:
    def mvnDeps = Seq(mvn"com.lihaoyi::upickle::${Versions.upickle}")
  object jvm extends DataShared:
    def moduleDeps = Seq(core.jvm)
    object test extends ScalaTests with SharedTests
  object js extends DataShared with SharedJS:
    def moduleDeps = Seq(core.js)
    object test extends ScalaJSTests with SharedTests

/** Tests that reproduce the cached results of reference/taxsimulator2.xlsx. */
object parity extends Module:
  object jvm extends Shared:
    def moduleDeps = Seq(data.jvm)
    object test extends ScalaTests with SharedTests
  object js extends SharedJS:
    def moduleDeps = Seq(data.js)
    object test extends ScalaJSTests with SharedTests

/** Demo website: Scala.js + Laminar, static files in `webapp/static`.
 *  `./mill webapp.site` assembles the site (optimized JS) in out/webapp/site.dest;
 *  `./mill webapp.devSite` does the same with fast (unoptimized) linking;
 *  `./mill webapp.standalone` writes a single self-contained HTML file. */
object webapp extends ScalaJSModule:
  def scalaVersion = Versions.scala
  def scalaJSVersion = Versions.scalaJS
  def scalacOptions = Seq("-deprecation", "-feature", "-unchecked", "-Wunused:imports")
  def moduleDeps = Seq(data.js)
  def mvnDeps = Seq(mvn"com.raquo::laminar::${Versions.laminar}")
  def scalaJSUseMainModuleInitializer = true

  def staticFiles = Task.Source(moduleDir / "static")

  private def assemble(static: os.Path, jsDir: os.Path, out: os.Path): Unit =
    for p <- os.list(static) do os.copy(p, out / p.last, replaceExisting = true)
    os.copy(jsDir / "main.js", out / "main.js", replaceExisting = true)

  def site = Task {
    assemble(staticFiles().path, fullLinkJS().dest.path, Task.dest)
    PathRef(Task.dest)
  }

  def devSite = Task {
    assemble(staticFiles().path, fastLinkJS().dest.path, Task.dest)
    PathRef(Task.dest)
  }

  /** End-to-end browser test of the optimized site and the standalone file: sliders, bracket editor,
   *  presets, shareable links, tooltips, console errors. Needs Node 22+ and Chrome (CHROME=/path overrides).
   *  `./mill webapp.browserTest` or `./mill webapp.browserTest --screenshots /some/dir`. */
  def browserTest(args: String*) = Task.Command {
    val script = moduleDir / "e2e" / "browser-test.mjs"
    val r = os.proc("node", script, site().path, standalone().path, args)
      .call(stdout = os.Inherit, stderr = os.Inherit, check = false)
    if r.exitCode != 0 then throw new Exception(s"browser tests failed (exit ${r.exitCode})")
  }

  /** index.html with the stylesheet and script inlined, for sharing as one file. */
  def standalone = Task {
    val dir = site().path
    val css = os.read(dir / "styles.css")
    val js = os.read(dir / "main.js").replace("</script", "<\\/script")
    val html = os.read(dir / "index.html")
      .replace("""<link rel="stylesheet" href="styles.css">""", s"<style>\n$css\n</style>")
      .replace("""<script src="main.js"></script>""", s"<script>\n$js\n</script>")
    os.write(Task.dest / "taxsim-demo.html", html)
    PathRef(Task.dest / "taxsim-demo.html")
  }
